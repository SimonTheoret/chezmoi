layout {
    new_tab_template {
            // the default zellij compact-bar and status bar plugins
            pane
            pane size=1 borderless=true {
                plugin location="compact-bar"
            }
    }
    tab name="editor" {
        pane split_direction="vertical" {
            name "editor"
        }
    	pane size=1 borderless=true {
            plugin location="compact-bar"
    	}
    }
     tab name="term" {
        pane {
            name "term"
        }
    	pane size=1 borderless=true {
            plugin location="compact-bar"
    	}
    }
{{ if (or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux"))  }}
     tab name="claude" {
        pane {
            name "claude"
            command "claude"
        }
    }
        {{ else }}
     tab name="opencode" {
        pane {
            name "opencode"
            command "opencode"
        }
    }
{{ end }}

    tab name="yazi" {
        pane {
            name   "yazi"
            command "yazi"
        }
    	pane size=1 borderless=true {
            plugin location="compact-bar"
    	}
    }
    tab name="lazygit" {
        pane {
            name "lazygit"
            command "lazygit"
        }
    	pane size=1 borderless=true {
            plugin location="compact-bar"
    	}
    }
    tab name="lazydocker" {
        pane {
            name "lazydocker"
            command "lazydocker"
        }
    	pane size=1 borderless=true {
            plugin location="compact-bar"
    	}
    }
}
